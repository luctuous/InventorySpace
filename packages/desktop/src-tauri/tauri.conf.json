{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inventory",
  "version": "0.1.0",
  "identifier": "cat.inventari.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Inventory",
    "longDescription": "Desktop client for the inventory server."
  }
}
